-- ESP MANAGER
-- ============================================================

local ESP = {}
local DrawingAvailable = type(Drawing) == "table" and type(Drawing.new) == "function"

destroyESP = function(player)
    local data = ESP[player]
    if not data then return end

    for _, item in pairs(data.instances) do
        safeDestroy(item)
    end

    if data.line then
        pcall(function()
            data.line.Visible = false
            data.line:Remove()
        end)
    end

    ESP[player] = nil
end

clearESP = function()
    for player in pairs(ESP) do
        destroyESP(player)
    end
end

local function makeESP(player)
    local cache = PlayerCache[player]
    local head = cache and cache.Head

    if not head or not head.Parent then
        return
    end

    if ESP[player] and ESP[player].head == head then
        return
    end

    destroyESP(player)

    local data = {
        head = head,
        instances = {},
        box = nil,
        billboard = nil,
        label = nil,
        health = nil,
        line = nil,
    }

    local color = roleColor(getRole(player))

    local box = Instance.new("BoxHandleAdornment")
    box.Name = "CinderV3Box"
    box.Adornee = head
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Size = Vector3.new(2.5, 4.5, 2.5)
    box.Transparency = Config.ESPTransparency
    box.Color3 = color
    box.Parent = head

    data.box = box
    table.insert(data.instances, box)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CinderV3Info"
    billboard.Adornee = head
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(240, 60)
    billboard.StudsOffset = Vector3.new(0, 3.5, 0)
    billboard.Parent = head

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 0, 34)
    label.Font = Enum.Font.GothamBold
    label.TextScaled = true
    label.TextStrokeTransparency = 0
    label.TextColor3 = color
    label.Text = player.Name
    label.Parent = billboard

    data.billboard = billboard
    data.label = label
    table.insert(data.instances, billboard)

    if DrawingAvailable and Config.ESPTracers then
        local ok, line = pcall(function()
            return Drawing.new("Line")
        end)

        if ok and line then
            line.Thickness = 1.5
            line.Transparency = 0.9
            line.Color = color
            line.Visible = false
            data.line = line
        end
    end

    if Config.ESPHealth then
        local health = Instance.new("TextLabel")
        health.BackgroundTransparency = 1
        health.Position = UDim2.fromOffset(0, 34)
        health.Size = UDim2.new(1, 0, 0, 22)
        health.Font = Enum.Font.Gotham
        health.TextScaled = true
        health.TextStrokeTransparency = 0.2
        health.TextColor3 = Color3.fromRGB(240, 240, 240)
        health.Parent = billboard

        data.health = health
    end

    ESP[player] = data
end

local function updateESP(now)
    if not Config.ESP then
        if next(ESP) then clearESP() end
        return
    end

    local myRoot = root()
    local cam = camera()
    for player, cache in pairs(PlayerCache) do
        if cache and cache.Head and cache.Head.Parent and alive(player) then
            local withinRange = true
            if myRoot and cache.HRP then
                withinRange = (myRoot.Position - cache.HRP.Position).Magnitude <= Config.ESPMaxDistance
            end

            if not withinRange then
                destroyESP(player)
                continue
            end

            local role = getRole(player)

            if roleEnabled(role) then
                makeESP(player)
                local data = ESP[player]

                if data then
                    local color = roleColor(role)

                    if data.box then
                        data.box.Color3 = color
                        data.box.Transparency = Config.ESPTransparency
                    end

                    local distanceText = ""
                    if Config.ESPDistance then
                        if myRoot and cache.HRP then
                            distanceText = string.format(
                                " • %dm",
                                math.floor((myRoot.Position - cache.HRP.Position).Magnitude)
                            )
                        end
                    end

                    if data.label then
                        if Config.ESPNames then
                            data.label.Text = player.Name .. " [" .. role .. "]" .. distanceText
                        else
                            data.label.Text = role .. distanceText
                        end
                        data.label.TextColor3 = color
                    end

                    -- v5 LOD: далеко — без HP-обновления каждый тик
                    local dist = myRoot and cache.HRP and (myRoot.Position - cache.HRP.Position).Magnitude or 0
                    local isFar = dist > Config.ESPLodDistance
                    if data.health and cache.Humanoid and not isFar then
                        data.health.Text = string.format(
                            "HP: %d/%d",
                            math.floor(cache.Humanoid.Health),
                            math.floor(cache.Humanoid.MaxHealth)
                        )
                    elseif data.health and isFar then
                        data.health.Text = ""
                    end

                    if data.line then
                        local tracerOk = Config.ESPTracers
                        if tracerOk and Config.TracersMurdererOnly and role ~= "Murderer" then
                            tracerOk = false
                        end
                        if Perf.autoCut and Perf.autoCutTracers then tracerOk = false end
                        if tracerOk and cam and myRoot and cache.HRP then
                            local viewport, visible = cam:WorldToViewportPoint(cache.HRP.Position)
                            if visible and viewport.Z > 0 then
                                local from = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                                data.line.From = from
                                data.line.To = Vector2.new(viewport.X, viewport.Y)
                                data.line.Color = color
                                data.line.Visible = true
                            else
                                data.line.Visible = false
                            end
                        else
                            data.line.Visible = false
                        end
                    end
                end
            else
                destroyESP(player)
            end
        else
            destroyESP(player)
        end
    end
end

-- ============================================================
-- OBJECT ESP
-- ============================================================

local ObjectESP = {}
local ObjectCandidates = {}
local objectScanAt = 0

clearObjectESP = function()
    for obj, billboard in pairs(ObjectESP) do
        safeDestroy(billboard)
        ObjectESP[obj] = nil
    end
end

local function isCoin(obj)
    return obj:IsA("BasePart") and obj.Name:lower():find("coin", 1, true) ~= nil
end

local function objectLooksInteresting(obj)
    if not obj:IsA("BasePart") then
        return false
    end

    local name = obj.Name:lower()
    if name:find("coin", 1, true) then
        return Config.CoinESP
    end

    if not Config.ObjectESP then
        return false
    end

    return name:find("gun", 1, true)
        or name:find("knife", 1, true)
end

local function makeObjectESP(obj)
    if ObjectESP[obj] or not objectLooksInteresting(obj) then
        return
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "CinderV3Object"
    billboard.Adornee = obj
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.fromOffset(140, 28)
    billboard.StudsOffset = Vector3.new(0, 1.5, 0)
    billboard.Parent = obj

    local text = Instance.new("TextLabel")
    text.BackgroundTransparency = 1
    text.Size = UDim2.fromScale(1, 1)
    text.Font = Enum.Font.GothamBold
    text.TextScaled = true
    text.TextStrokeTransparency = 0
    text.Text = obj.Name
    text.TextColor3 = isCoin(obj)
        and Color3.fromRGB(255, 220, 70)
        or Color3.fromRGB(230, 230, 230)
    text.Parent = billboard

    ObjectESP[obj] = billboard
end

local function scanObjects(now)
    if not Config.ObjectESP and not Config.CoinESP then
        if next(ObjectESP) then clearObjectESP() end
        table.clear(ObjectCandidates)
        return
    end

    if now - objectScanAt < effectiveInterval(Config.ObjectInterval) then
        return
    end
    objectScanAt = now

    -- v4.1: сканируем Map/контейнер вместо всего workspace, дешевле на Delta
    local container = workspace:FindFirstChild("Map") or workspace:FindFirstChild("Coins")
        or workspace:FindFirstChild("CoinContainer") or workspace
    local myRoot = root()
    for _, obj in ipairs(container:GetDescendants()) do
        if objectLooksInteresting(obj) then
            if myRoot and obj:IsA("BasePart") then
                local ok, d = pcall(function()
                    return (myRoot.Position - obj.Position).Magnitude
                end)
                if ok and d and d > Config.ESPMaxDistance then
                    continue
                end
            end
            ObjectCandidates[obj] = true
            makeObjectESP(obj)
        end
    end

    for obj in pairs(ObjectCandidates) do
        if not obj.Parent or not objectLooksInteresting(obj) then
            ObjectCandidates[obj] = nil
            if ObjectESP[obj] then
                safeDestroy(ObjectESP[obj])
                ObjectESP[obj] = nil
            end
        end
    end
end

bind("ObjectAdded", workspace.DescendantAdded, function(obj)
    if objectLooksInteresting(obj) then
        ObjectCandidates[obj] = true
        if Config.ObjectESP or Config.CoinESP then
            makeObjectESP(obj)
        end
    end
end)

bind("ObjectRemoved", workspace.DescendantRemoving, function(obj)
    ObjectCandidates[obj] = nil
    if ObjectESP[obj] then
        safeDestroy(ObjectESP[obj])
        ObjectESP[obj] = nil
    end
end)

