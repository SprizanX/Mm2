-- ============================================================

local farmAt = 0
local function updateFarm(now)
    if not Config.CoinFarm and not Config.AutoEvent then return end
    if now - farmAt < 0.3 then return end
    farmAt = now
    local hrp = root()
    if not hrp or not alive(LocalPlayer) then return end
    if Config.Fly then return end
    local best, bestD = nil, (Config.FarmRange or 60)
    for obj in pairs(ObjectCandidates) do
        if obj.Parent and obj:IsA("BasePart") then
            local nm = obj.Name:lower()
            local want = false
            if Config.CoinFarm and nm:find("coin", 1, true) then want = true end
            if Config.AutoEvent and (nm:find("candy", 1, true) or nm:find("gift", 1, true) or nm:find("egg", 1, true) or nm:find("snow", 1, true) or nm:find("event", 1, true)) then want = true end
            if want then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < bestD then best, bestD = obj, d end
            end
        end
    end
    if best then
        local step = math.min(Config.FarmStep or 8, bestD)
        if step > 1 then
            local dir = (best.Position - hrp.Position).Unit
            hrp.CFrame = hrp.CFrame + dir * step
        end
    end
end

