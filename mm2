getgenv().Cinder_Rollback = function(sha)
    local url = string.format("https://raw.githubusercontent.com/SprizanX/Mm2/%s/mm2", tostring(sha))
    local ok, src = pcall(function() return game:HttpGet(url) end)
    if ok and src and #src > 1000 then
        notify("Cinder v7.0", "Rollback done, restarting...", 2)
        task.wait(0.5)
        loadstring(src)()
    else
        notify("Cinder v7.0", "Rollback failed", 3)
    end
end
task.spawn(function()
    task.wait(5)
    local ok, resp = pcall(function()
        return game:HttpGet("https://api.github.com/repos/SprizanX/Mm2/commits?path=mm2&per_page=2")
    end)
    if not ok or not resp then return end
    local ok2, commits = pcall(function() return HttpService:JSONDecode(resp) end)
    if not ok2 or type(commits) ~= "table" or #commits == 0 then return end
    local latest = commits[1] and commits[1].sha or ""
    local msg = ""
    pcall(function() msg = commits[1].commit.message end)
    if (Config.LastCommitSha or "") ~= "" and Config.LastCommitSha ~= latest then
        notify("Cinder v7.0", "Update: " .. tostring(msg):sub(1, 120), 5)
    end
    Config.LastCommitSha = latest
    getgenv().CinderV7_Changelog = msg
    getgenv().CinderV7_PrevSha = (commits[2] and commits[2].sha) or ""
end)

