-- RADAR (v6.0: скрыть себя, цвета по ролям)
-- ============================================================

local Radar = {}
local radarGui
local radarFrame

local function destroyRadar()
    if radarGui then
        radarGui:Destroy()
        radarGui = nil
        radarFrame = nil
    end
    table.clear(Radar)
end

local function createRadar()
    if radarGui then return end

    radarGui = Instance.new("ScreenGui")
    radarGui.Name = "CinderV3Radar"
    radarGui.ResetOnSpawn = false
    do local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:FindFirstChild("PlayerGui") if not pg then return end radarGui.Parent = pg end

    radarFrame = Instance.new("Frame")
    radarFrame.AnchorPoint = Vector2.new(1, 0)
    radarFrame.Position = UDim2.new(1, -18, 0, 90)
    radarFrame.Size = UDim2.fromOffset(180, 180)
    radarFrame.BackgroundTransparency = 0.25
    radarFrame.Parent = radarGui

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.new(1, 0, 0, 24)
    title.Font = Enum.Font.GothamBold
    title.Text = "CINDER RADAR v6"
    title.TextScaled = true
    title.Parent = radarFrame

    local center = Instance.new("Frame")
    center.AnchorPoint = Vector2.new(0.5, 0.5)
    center.Position = UDim2.fromScale(0.5, 0.5)
    center.Size = UDim2.fromOffset(6, 6)
    center.Parent = radarFrame
end

local function updateRadar()
    if not Config.Radar then
        destroyRadar()
        return
    end

    createRadar()

    local r = root()
    if not r then return end
    local seen = {}

    for player, cache in pairs(PlayerCache) do
        -- v6.0: скрыть свой dot
        if player == LocalPlayer and Config.RadarHideSelf then
            continue
        end

        if cache and cache.HRP and cache.HRP.Parent then
            local delta = cache.HRP.Position - r.Position
            local flat = Vector3.new(delta.X, 0, delta.Z)
            local distance = flat.Magnitude
            local range = Config.RadarRange * (Config.RadarZoom or 1)

            if distance <= range then
                -- v7.0: поворот радара по камере
                local lx, lz = flat.X, flat.Z
                if Config.RadarRotate then
                    local cam0 = camera()
                    if cam0 then
                        local fw = cam0.CFrame.LookVector
                        local yaw = math.atan2(fw.X, fw.Z)
                        local c0, s0 = math.cos(yaw), math.sin(yaw)
                        lx, lz = flat.X * c0 - flat.Z * s0, flat.X * s0 + flat.Z * c0
                    end
                end
                local x = math.clamp(lx / range, -1, 1)
                local y = math.clamp(lz / range, -1, 1)

                local dot = Radar[player]
                if not dot or not dot.Parent then
                    dot = Instance.new("Frame")
                    dot.AnchorPoint = Vector2.new(0.5, 0.5)
                    dot.Size = UDim2.fromOffset(8, 8)
                    dot.BorderSizePixel = 0
                    dot.Parent = radarFrame
                    Radar[player] = dot
                end
                dot.Position = UDim2.fromScale(0.5 + x * 0.45, 0.5 + y * 0.45)
                dot.BackgroundColor3 = radarDotColor(getRole(player))
                dot.Visible = true
                seen[player] = true
            end
        end
    end

    -- v7.0: блипы монет/гана на радаре
    if (Config.RadarShowCoins or Config.RadarShowGun) and radarFrame then
        local blips = 0
        local brange = Config.RadarRange * (Config.RadarZoom or 1)
        for obj in pairs(ObjectCandidates) do
            if blips >= 12 then break end
            if obj.Parent and obj:IsA("BasePart") then
                local nm = obj.Name:lower()
                local isCoinB = Config.RadarShowCoins and nm:find("coin", 1, true) ~= nil
                local isGunB = Config.RadarShowGun and (nm:find("gundrop", 1, true) or nm:find("droppedgun", 1, true) or nm == "gun")
                if isCoinB or isGunB then
                    local dd = obj.Position - r.Position
                    local fl = Vector3.new(dd.X, 0, dd.Z)
                    if fl.Magnitude <= brange then
                        local bx, bz = fl.X, fl.Z
                        if Config.RadarRotate then
                            local cam1 = camera()
                            if cam1 then
                                local fw1 = cam1.CFrame.LookVector
                                local yaw1 = math.atan2(fw1.X, fw1.Z)
                                local c1, s1 = math.cos(yaw1), math.sin(yaw1)
                                bx, bz = fl.X * c1 - fl.Z * s1, fl.X * s1 + fl.Z * c1
                            end
                        end
                        local dot = Radar[obj]
                        if not dot or not dot.Parent then
                            dot = Instance.new("Frame")
                            dot.AnchorPoint = Vector2.new(0.5, 0.5)
                            dot.Size = UDim2.fromOffset(5, 5)
                            dot.BorderSizePixel = 0
                            dot.Parent = radarFrame
                            Radar[obj] = dot
                        end
                        dot.Position = UDim2.fromScale(0.5 + math.clamp(bx / brange, -1, 1) * 0.45, 0.5 + math.clamp(bz / brange, -1, 1) * 0.45)
                        dot.BackgroundColor3 = isGunB and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 220, 70)
                        dot.Visible = true
                        seen[obj] = true
                        blips += 1
                    end
                end
            end
        end
    end

    for player, dot in pairs(Radar) do
        if not seen[player] then
            safeDestroy(dot)
            Radar[player] = nil
        end
    end
end

-- ============================================================
-- AIM ASSIST (v6.0: adaptive FOV, приоритет по ролям)
-- ============================================================

local function targetAllowed(role)
    if role == "Murderer" then return Config.AimMurderer end
    if role == "Sheriff" then return Config.AimSheriff end
    if role == "Innocent" then return Config.AimInnocent end
    return false
end

-- v5.1: кеш line-of-sight на 50мс
local losCache = {}
local losCacheAt = {}
local LOS_CACHE_TTL = 0.05

local function hasLineOfSight(part)
    if not Config.AimWallCheck then
        return true
    end

    local cam = camera()
    local localChar = character()
    if not cam or not localChar or not part then
        return false
    end

    local now = os.clock()
    for k, v in pairs(losCache) do
        if now - losCacheAt[k] > LOS_CACHE_TTL then
            losCache[k] = nil
            losCacheAt[k] = nil
        end
    end

    local cacheKey = part:GetFullName() .. "|" .. tostring(part.Position)
    local cached = losCache[cacheKey]
    local cachedAt = losCacheAt[cacheKey]
    if cached ~= nil and cachedAt and now - cachedAt < LOS_CACHE_TTL then
        return cached
    end

    local origin = cam.CFrame.Position
    local direction = part.Position - origin

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {localChar}
    params.IgnoreWater = true

    local result = workspace:Raycast(origin, direction, params)
    local hit = result == nil or result.Instance:IsDescendantOf(part.Parent)
    losCache[cacheKey] = hit
    losCacheAt[cacheKey] = now
    return hit
end

local function roleFOV(role)
    if role == "Murderer" and (Config.AimFOVMurderer or -1) > 0 then return Config.AimFOVMurderer end
    if role == "Sheriff" and (Config.AimFOVSheriff or -1) > 0 then return Config.AimFOVSheriff end
    if role == "Innocent" and (Config.AimFOVInnocent or -1) > 0 then return Config.AimFOVInnocent end
    return Config.AimFOV
end

local AimTouch = { active = false, pos = nil }
pcall(function()
    UserInputService.TouchStarted:Connect(function(input)
        AimTouch.active = true
        AimTouch.pos = input.Position
    end)
    UserInputService.TouchEnded:Connect(function()
        AimTouch.active = false
        AimTouch.pos = nil
    end)
    UserInputService.TouchMoved:Connect(function(input)
        if AimTouch.active then AimTouch.pos = input.Position end
    end)
end)

-- v6.0-final: точка прицеливания — мышь на ПК, центр экрана / последний тап на мобайле
local function getAimAnchor()
    local cam = camera()
    local vs = cam and cam.ViewportSize or Vector2.new(500, 500)
    if UserInputService.TouchEnabled and (AimTouch.pos or not UserInputService.MouseEnabled) then
        return AimTouch.pos or Vector2.new(vs.X / 2, vs.Y / 2)
    end
    local ok, m = pcall(function() return UserInputService:GetMouseLocation() end)
    if ok and m then return m end
    return Vector2.new(vs.X / 2, vs.Y / 2)
end

local function pickAimPart(cache)
    if Config.AimAutoPart and cache.Head and cache.HRP then
        local cam = camera()
        if cam then
            local mouse = getAimAnchor()
            local hp, hv = cam:WorldToViewportPoint(cache.Head.Position)
            local rp, rv = cam:WorldToViewportPoint(cache.HRP.Position)
            if hv and rv then
                local dh = (Vector2.new(hp.X, hp.Y) - mouse).Magnitude
                local dr = (Vector2.new(rp.X, rp.Y) - mouse).Magnitude
                return (dh <= dr) and cache.Head or cache.HRP
            end
        end
        return cache.Head
    end
    return cache[Config.AimPart] or cache.Head or cache.HRP
end

local function closestTarget()
    local cam = camera()
    if not cam then return nil end

    local mouse = getAimAnchor()
    local best
    local bestDistance = math.huge
    local bestPriority = 0

    local priority = {
        ["Murderer"] = 3,
        ["Sheriff"] = 2,
        ["Innocent"] = 1,
        ["Unknown"] = 0,
    }

    for player, cache in pairs(PlayerCache) do
        if cache and cache.Humanoid and cache.Humanoid.Health > 0 then
            local role = getRole(player)
            if targetAllowed(role) then
                local part = pickAimPart(cache)
                if part then
                    local point, visible = cam:WorldToViewportPoint(part.Position)
                    if visible and point.Z > 0 and hasLineOfSight(part) then
                        local d = (Vector2.new(point.X, point.Y) - mouse).Magnitude
                        local fov = roleFOV(role)

                        -- v6.0: adaptive FOV — близкие цели сужают FOV
                        if Config.AimAdaptiveFOV and d < fov / 4 then
                            fov = fov / 2
                        end

                        if d <= fov then
                            local p = priority[role] or 0
                            if p > bestPriority or (p == bestPriority and d < bestDistance) then
                                bestPriority = p
                                bestDistance = d
                                best = part
                            end
                        end
                    end
                end
            end
        end
    end

    return best
end

local aimSearchAt = 0
local AimLock = { part = nil, since = 0 } -- v7.0

local function updateAimCircle()
    -- v6.0-final: GUI-круг для мобайла (Drawing нет на Delta) + Drawing на ПК
    local mouse = getAimAnchor()
    if not DrawingAvailable then
        if VisualState.FOVGui == nil then
            local ok, pg = pcall(function() return LocalPlayer:WaitForChild("PlayerGui") end)
            if ok and pg then
                local g = Instance.new("ScreenGui")
                g.Name = "CinderV6FOV"
                g.ResetOnSpawn = false
                g.IgnoreGuiInset = true
                g.Parent = pg
                local f = Instance.new("Frame")
                f.AnchorPoint = Vector2.new(0.5, 0.5)
                f.BackgroundTransparency = 1
                local stroke = Instance.new("UIStroke")
                stroke.Thickness = 1.5
                stroke.Transparency = 0.2
                stroke.Color = Color3.fromRGB(255, 255, 255)
                stroke.Parent = f
                local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(1, 0)
                corner.Parent = f
                f.Parent = g
                VisualState.FOVGui = g
                VisualState.FOVFrame = f
            end
        end
        local f = VisualState.FOVFrame
        if f then
            f.Position = UDim2.fromOffset(mouse.X, mouse.Y)
            f.Size = UDim2.fromOffset(Config.AimFOV * 2, Config.AimFOV * 2)
            f.Visible = Config.AimAssist and Config.AimCircle
        end
        if VisualState.FOVCircle then pcall(function() VisualState.FOVCircle.Visible = false end) end
        -- v7.1: лок-индикатор из кэша AimLock (поиск цели тут вешал каждый кадр)
        if f and Config.AimAssist then
            local stroke = f:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = (AimLock.part ~= nil) and Color3.fromRGB(255, 70, 70) or Color3.fromRGB(255, 255, 255) end
        end
        return
    end
    if VisualState.FOVGui then pcall(function() VisualState.FOVGui.Enabled = false end) end

    if not VisualState.FOVCircle then
        local ok, circle = pcall(function()
            return Drawing.new("Circle")
        end)
        if ok and circle then
            circle.Filled = false
            circle.Thickness = 1.5
            circle.Transparency = 0.8
            circle.Color = Color3.fromRGB(255, 255, 255)
            VisualState.FOVCircle = circle
        end
    end

    local circle = VisualState.FOVCircle
    if not circle then return end

    circle.Position = mouse
    circle.Radius = Config.AimFOV
    circle.Visible = Config.AimAssist and Config.AimCircle
end

bind("AimAssist", RunService.RenderStepped, function()
    updateAimCircle()
    if not Config.AimAssist then return end

    local now = os.clock()
    if now - aimSearchAt < 1 / 30 then return end
    aimSearchAt = now

    local target = closestTarget()
    local cam = camera()

    -- v7.0: задержка реакции + humanizer
    if target ~= AimLock.part then
        AimLock.part = target
        AimLock.since = now
    end
    if target and (Config.AimReaction or 0) > 0 and (now - AimLock.since) < Config.AimReaction then
        return
    end

    if target and cam then
        local alpha = math.clamp(Config.AimSmooth, 0.01, 1)
        if Config.AimHumanizer then
            local spd = 0
            pcall(function() spd = target.AssemblyLinearVelocity.Magnitude end)
            alpha = alpha / (1 + spd / 60)
            alpha = alpha * (0.85 + math.random() * 0.3)
        end
        local aimPos = target.Position
