local function bind(name, signal, callback)
    if Connections[name] then
        Connections[name]:Disconnect()
    end
    Connections[name] = signal:Connect(callback)
    return Connections[name]
end

local function unbind(name)
    local c = Connections[name]
    if c then
        c:Disconnect()
        Connections[name] = nil
    end
end

local function cleanup(name)
    local taskFn = CleanupTasks[name]
    if taskFn then
        pcall(taskFn)
        CleanupTasks[name] = nil
    end
end

local function registerCleanup(name, fn)
    CleanupTasks[name] = fn
end

local function restoreMovementStats()
    local h = humanoid()
    if not h then return end

    if OriginalMovement.WalkSpeed ~= nil then
        h.WalkSpeed = OriginalMovement.WalkSpeed
    end

    if OriginalMovement.JumpPower ~= nil then
        h.JumpPower = OriginalMovement.JumpPower
    end

    OriginalMovement.WalkSpeed = nil
    OriginalMovement.JumpPower = nil
end

