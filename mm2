local ESP = {}
local DrawingAvailable = type(Drawing) == "table" and type(Drawing.new) == "function"

destroyESP = function(player)
    local data = ESP[player]
    if not data then return end

    -- v6.0: чистим Drawing-объекты если ESPMode == Drawing2D
    if Config.ESPMode == "Drawing2D" then
        if data.drawingBox then pcall(function() data.drawingBox:Remove() end) end
        if data.drawingLabel then pcall(function() data.drawingLabel:Remove() end) end
    end

    for _, item in pairs(data.instances) do
        safeDestroy(item)
    end

    if data.line then
        pcall(function()
            data.line.Visible = false
            data.line:Remove()
        end)
    end

    ESP[player] = nil
end

clearESP = function()
    for player in pairs(ESP) do
        destroyESP(player)
    end
end

local function makeESP(player)
    local cache = PlayerCache[player]
    local head = cache and cache.Head

    if not head or not head.Parent then
        return
    end

    if ESP[player] and ESP[player].head == head then
        return
    end

    destroyESP(player)

    local data = {
        head = head,
        instances = {},
        box = nil,
        billboard = nil,
        label = nil,
        health = nil,
        line = nil,
        drawingBox = nil,
        drawingLabel = nil,
    }

    local color = roleColor(getRole(player))

    -- v6.0: гибридный ESP — бокс + билборд
    if Config.ESPMode == "Hybrid" or Config.ESPMode == "Billboard" then
        local box = Instance.new("BoxHandleAdornment")
        box.Name = "CinderV3Box"
        box.Adornee = head
        box.AlwaysOnTop = true
        box.ZIndex = 5
        box.Size = Vector3.new(2.5, 4.5, 2.5)
        box.Transparency = Config.ESPTransparency
        box.Color3 = color
        box.Parent = head

        data.box = box
        table.insert(data.instances, box)
    end

    if Config.ESPMode == "Hybrid" or Config.ESPMode == "Billboard" then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "CinderV3Info"
        billboard.Adornee = head
        billboard.AlwaysOnTop = true
        billboard.Size = UDim2.fromOffset(240, 60)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.Parent = head

        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 0, 34)
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.TextStrokeTransparency = 0
        label.TextColor3 = color
        label.Text = player.Name
        label.Parent = billboard

        data.billboard = billboard
        data.label = label
        table.insert(data.instances, billboard)
    end

    -- v6.0: Drawing2D mode
    if Config.ESPMode == "Drawing2D" then
        local ok, boxDraw = pcall(function()
            return Drawing.new("Box")
        end)
        if ok and boxDraw then
            boxDraw.Color = color
            boxDraw.Transparency = Config.ESPTransparency
            boxDraw.Outline = true
            boxDraw.Filled = false
            boxDraw.Visible = true
            data.drawingBox = boxDraw
            table.insert(data.instances, boxDraw)
        end

        local ok, labelDraw = pcall(function()
            return Drawing.new("Text")
        end)
        if ok and labelDraw then
            labelDraw.Text = player.Name
            labelDraw.Color = color
            labelDraw.Outline = true
            labelDraw.Center = false
            labelDraw.Size = 14
            labelDraw.Visible = true
            data.drawingLabel = labelDraw
            table.insert(data.instances, labelDraw)
        end
    end

    if DrawingAvailable and Config.ESPTracers then
        local ok, line = pcall(function()
            return Drawing.new("Line")
        end)

        if ok and line then
            line.Thickness = 1.5
            line.Transparency = 0.9
            line.Color = color
            line.Visible = false
            data.line = line
        end
    end

    if Config.ESPHealth and data.billboard then
        local health = Instance.new("TextLabel")
        health.BackgroundTransparency = 1
        health.Position = UDim2.fromOffset(0, 34)
        health.Size = UDim2.new(1, 0, 0, 22)
        health.Font = Enum.Font.Gotham
        health.TextScaled = true
        health.TextStrokeTransparency = 0.2
        health.TextColor3 = Color3.fromRGB(240, 240, 240)
        health.Parent = data.billboard

        data.health = health
    end

    ESP[player] = data
end

updateESP = function(now)
    if not Config.ESP then
        if next(ESP) then clearESP() end
        return
    end

    local myRoot = root()
    local cam = camera()
    for player, cache in pairs(PlayerCache) do
        if cache and cache.Head and cache.Head.Parent and alive(player) then
            local withinRange = true
            if myRoot and cache.HRP then
                withinRange = (myRoot.Position - cache.HRP.Position).Magnitude <= Config.ESPMaxDistance
            end

            if not withinRange then
                destroyESP(player)
                continue
            end

            local role = getRole(player)

            if roleEnabled(role) then
                makeESP(player)
                local data = ESP[player]

                if data then
                    local color = roleColor(role)

                    if data.box then -- v8.0: пишем пропсы только при изменении
                        if data._boxColor ~= color then data.box.Color3 = color data._boxColor = color end
                        if data._boxTransp ~= Config.ESPTransparency then data.box.Transparency = Config.ESPTransparency data._boxTransp = Config.ESPTransparency end
                    end

                    if data.drawingBox then
                        data.drawingBox.Color = color
                    end

                    if data.drawingLabel then
                        data.drawingLabel.Text = player.Name
                        data.drawingLabel.Color = color
                    end

                    local distanceText = ""
                    if Config.ESPDistance then
                        if myRoot and cache.HRP then
                            distanceText = string.format(
                                " • %dm",
                                math.floor((myRoot.Position - cache.HRP.Position).Magnitude)
                            )
                        end
                    end

                    if data.label then -- v8.0: текст/цвет только при изменении
                        local _txt = Config.ESPNames and (player.Name .. " [" .. role .. "]" .. distanceText) or (role .. distanceText)
                        if data.label.Text ~= _txt then data.label.Text = _txt end
                        if data._labelColor ~= color then data.label.TextColor3 = color data._labelColor = color end
                    end

                    -- v6.0: multi-level LOD
                    local dist = myRoot and cache.HRP and (myRoot.Position - cache.HRP.Position).Magnitude or 0
                    local isFar = dist > Config.ESPLodDistance
                    local isVeryFar = dist > Config.ESPLodFarDistance

                    if data.health and cache.Humanoid and not isFar then -- v8.0: HP-текст только при изменении
                        local _hp = string.format("HP: %d/%d", math.floor(cache.Humanoid.Health), math.floor(cache.Humanoid.MaxHealth))
                        if data.health.Text ~= _hp then data.health.Text = _hp end
                    elseif data.health then
                        if data.health.Text ~= "" then data.health.Text = "" end
                    end

                    -- v6.0: Billboard скрывается очень далеко (v8.0: guard)
                    if data.billboard then
                        local _wantBB = not isVeryFar
                        if data.billboard.Enabled ~= _wantBB then data.billboard.Enabled = _wantBB end
                    end

                    -- v6.0: Drawing2D LOD — скрывать label далеко
                    if Config.ESPMode == "Drawing2D" then
                        if isVeryFar and data.drawingLabel then
                            data.drawingLabel.Visible = false
                        elseif data.drawingLabel then
                            data.drawingLabel.Visible = true
                        end
                    end

                    if data.line then
                        local tracerOk = Config.ESPTracers
                        if tracerOk and Config.TracersMurdererOnly and role ~= "Murderer" then
                            tracerOk = false
                        end
                        if Perf.autoCut and Perf.autoCutTracers then tracerOk = false end
                        if tracerOk and cam and myRoot and cache.HRP then
                            local viewport, visible = cam:WorldToViewportPoint(cache.HRP.Position)
                            if visible and viewport.Z > 0 then
                                local from = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
                                data.line.From = from
                                data.line.To = Vector2.new(viewport.X, viewport.Y)
                                data.line.Color = color
                                data.line.Visible = true
                            else
                                data.line.Visible = false
                            end
                        else
                            data.line.Visible = false
                        end
                    end
                end
            else
                destroyESP(player)
            end
        else
            destroyESP(player)
        end
    end
end

