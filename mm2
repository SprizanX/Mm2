-- ============================================================

local RoundTrack = { alive = {}, kills = 0, round = 0, started = false }
local function updateRoundTrack()
    for p in pairs(RoundTrack.alive) do
        if PlayerCache[p] == nil then RoundTrack.alive[p] = nil end
    end
    local anyRole, aliveN = false, 0
    for player in pairs(PlayerCache) do
        local role = getRole(player)
        if role ~= "Unknown" then anyRole = true end
        local isA = alive(player)
        if RoundTrack.alive[player] == nil then RoundTrack.alive[player] = isA end
        if RoundTrack.alive[player] and not isA then
            RoundTrack.kills += 1
            if Config.KillFeed then
                pcall(function() Rayfield:Notify({ Title = "Cinder v7.0", Content = string.format("X %s [%s] kills: %d", player.Name, role, RoundTrack.kills), Duration = 2 }) end)
            end
            Core.emit("death", player, role)
        end
        RoundTrack.alive[player] = isA
        if isA then aliveN += 1 end
    end
    if anyRole and not RoundTrack.started then
        RoundTrack.started = true
        RoundTrack.round += 1
        RoundTrack.kills = 0
        pcall(function() Rayfield:Notify({ Title = "Cinder v7.0", Content = string.format("Round #%d started: %d players", RoundTrack.round, aliveN), Duration = 3 }) end)
        Core.emit("round_start", RoundTrack.round)
    elseif not anyRole and RoundTrack.started then
        RoundTrack.started = false
        pcall(function() Rayfield:Notify({ Title = "Cinder v7.0", Content = string.format("Round #%d over", RoundTrack.round), Duration = 3 }) end)
        Core.emit("round_end", RoundTrack.round)
    end
end

