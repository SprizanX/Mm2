local SkeletonPool = {}
local SkelEdges = {
    {"Head","Torso"},{"Head","UpperTorso"},{"Torso","Left Arm"},{"Torso","Right Arm"},
    {"Torso","Left Leg"},{"Torso","Right Leg"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"UpperTorso","RightUpperArm"},
    {"LowerTorso","LeftUpperLeg"},{"LowerTorso","RightUpperLeg"},
    {"LeftUpperArm","LeftLowerArm"},{"RightUpperArm","RightLowerArm"},
    {"LeftUpperLeg","LeftLowerLeg"},{"RightUpperLeg","RightLowerLeg"},
}

local function updateSkeleton()
    if not DrawingAvailable then return end
    local cam = camera()
    if not cam then return end
    local myRoot = root()
    for player, cache in pairs(PlayerCache) do
        local c = cache and cache.Character
        local show = Config.Skeleton and Config.ESP and c and alive(player) and roleEnabled(getRole(player))
        local pool = SkeletonPool[player]
        if not pool then pool = { lines = {} } SkeletonPool[player] = pool end
        local li = 0
        if show then
            -- v7.0: фейд ESP по дистанции
            if Config.ESPFade and myRoot and cache.HRP then
                local d = (myRoot.Position - cache.HRP.Position).Magnitude
                local data = ESP[player]
                if data and data.box then
                    data.box.Transparency = math.clamp(Config.ESPTransparency + (d / math.max(1, Config.ESPMaxDistance)) * 0.4, 0, 1)
                end
            end
            for _, e in ipairs(SkelEdges) do
                local a = c:FindFirstChild(e[1])
                local b = c:FindFirstChild(e[2])
                if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
                    local pa, va = cam:WorldToViewportPoint(a.Position)
                    local pb, vb = cam:WorldToViewportPoint(b.Position)
                    if va and vb then
                        li += 1
                        local ln = pool.lines[li]
                        if not ln then
                            local ok, l2 = pcall(function() return Drawing.new("Line") end)
                            if ok and l2 then ln = l2 pool.lines[li] = ln end
                        end
                        if ln then
                            ln.From = Vector2.new(pa.X, pa.Y)
                            ln.To = Vector2.new(pb.X, pb.Y)
                            ln.Color = roleColor(getRole(player))
                            ln.Thickness = 1.5
                            ln.Transparency = 0.9
                            ln.Visible = true
                        end
                    end
                end
            end
        end
        for i = li + 1, #pool.lines do
            pcall(function() pool.lines[i].Visible = false end)
        end
    end
    for p, pool in pairs(SkeletonPool) do
        if PlayerCache[p] == nil then
            for _, l in ipairs(pool.lines) do pcall(function() l:Remove() end) end
            SkeletonPool[p] = nil
        end
    end
end
registerCleanup("Skeleton", function()
    for _, pool in pairs(SkeletonPool) do
        for _, l in ipairs(pool.lines) do pcall(function() l:Remove() end) end
    end
    table.clear(SkeletonPool)
end)

