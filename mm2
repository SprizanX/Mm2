-- ============================================================
-- OFFSCREEN ARROWS
-- ============================================================

local OffscreenPool = {}
updateOffscreen = function()
    if not DrawingAvailable then return end
    if not Config.OffscreenArrows or not Config.ESP then
        for _, d in pairs(OffscreenPool) do pcall(function() d.Visible = false end) end
        return
    end
    local cam = camera()
    if not cam then return end
    local vs = cam.ViewportSize
    local center = Vector2.new(vs.X / 2, vs.Y / 2)
    for player, cache in pairs(PlayerCache) do
        if cache and cache.HRP and alive(player) and roleEnabled(getRole(player)) then
            local sp, visible = cam:WorldToViewportPoint(cache.HRP.Position)
            local tri = OffscreenPool[player]
            if not visible then
                if not tri then
                    local ok, t2 = pcall(function() return Drawing.new("Triangle") end)
                    if ok and t2 then OffscreenPool[player] = t2 tri = t2 end
                end
                if tri then
                    -- v6.0-final: направление на цель: проецируем вектор в экранные координаты
                    local dir3 = cam.CFrame:VectorToObjectSpace((cache.HRP.Position - cam.CFrame.Position))
                    local dir = Vector2.new(-dir3.X, -dir3.Y)
                    if dir.Magnitude < 0.001 then dir = Vector2.new(0, -1) end
                    dir = dir.Unit
                    local radius = math.min(vs.X, vs.Y) * 0.38
                    local tip = center + dir * radius
                    local perp = Vector2.new(-dir.Y, dir.X)
                    tri.PointA = tip
                    tri.PointB = tip - dir * 18 + perp * 10
                    tri.PointC = tip - dir * 18 - perp * 10
                    tri.Color = roleColor(getRole(player))
                    tri.Filled = true
                    tri.Transparency = 0.9
                    tri.Visible = true
                end
            elseif tri then
                tri.Visible = false
            end
        elseif OffscreenPool[player] then
            OffscreenPool[player].Visible = false
        end
    end
end
registerCleanup("Offscreen", function()
    for k, d in pairs(OffscreenPool) do pcall(function() d:Remove() end) OffscreenPool[k] = nil end
end)

-- ============================================================
-- CHAMS (v6.0-final: Highlight-обводка, работает на Delta/мобайле)
-- ============================================================

updateChams = function()
    for player, cache in pairs(PlayerCache) do
        local c = cache and cache.Character
        if Config.Chams and Config.ESP and c and alive(player) and roleEnabled(getRole(player)) then
            local h = c:FindFirstChild("CinderChams")
            if not h or not h:IsA("Highlight") then
                if h then pcall(function() h:Destroy() end) end
                local ok, hl = pcall(function()
                    local x = Instance.new("Highlight")
                    x.Name = "CinderChams"
                    x.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    x.FillTransparency = 0.6
                    x.OutlineTransparency = 0
                    x.Adornee = c
                    x.Parent = c
                    return x
                end)
                h = ok and hl or nil
            end
            if h then
                pcall(function()
                    h.FillColor = roleColor(getRole(player))
                    h.OutlineColor = roleColor(getRole(player))
                    h.Enabled = true
                end)
            end
        elseif c then
            local h = c:FindFirstChild("CinderChams")
            if h then pcall(function() h:Destroy() end) end
        end
    end
end

