    MobileGui.ResetOnSpawn = false
    MobileGui.Parent = pg

    local btnSize = Config.MobileButtonSize or 80

    local function mkBtn(text, pos, cb, doubleTap, fontSize)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(btnSize, btnSize)
        b.Position = pos
        b.Text = text
        b.Font = Enum.Font.GothamBold
        b.TextScaled = true
        b.BackgroundTransparency = 0.3
        b.Parent = MobileGui

        local tapCount = 0
        local lastTap = 0
        local function onTap()
            local now = os.clock()
            if Config.MobileDoubleTap and (now - lastTap) < 0.3 then
                tapCount += 1
                if tapCount >= 2 then
                    cb(true)
                    tapCount = 0
                end
            else
                tapCount = 1
                lastTap = now
                cb(false)
            end
        end
        b.MouseButton1Click:Connect(onTap)
        pcall(function()
            if b.TouchTap then b.TouchTap:Connect(onTap) end
        end)
        return b
    end

    -- внизу по центру — управление полётом
    mkBtn("↑", UDim2.new(0.5, -btnSize - 5, 0.5, 0), function(double)
