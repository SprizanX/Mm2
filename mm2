-- v5 Notify queue: не спамим, складываем в очередь
local NotifyQueue = {}
local notifyBusy = false
local function notify(title, content, duration)
    table.insert(NotifyQueue, {title = title, content = content, duration = duration or 3})
    if notifyBusy then return end
    notifyBusy = true
    task.spawn(function()
        while #NotifyQueue > 0 do
            local n = table.remove(NotifyQueue, 1)
            pcall(function() Rayfield:Notify({Title = n.title, Content = n.content, Duration = n.duration}) end)
            task.wait(0.6)
        end
        notifyBusy = false
    end)
end

