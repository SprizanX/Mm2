-- Public diagnostic helper for debugging.
getgenv().CinderV5_Status = function()
    return getgenv().CinderMMMv4_Status()
end
getgenv().CinderMMMv41_Status = getgenv().CinderMMMv41_Status or nil
getgenv().CinderMMMv4_Status = function()
    local players = 0
    for _ in pairs(PlayerCache) do players += 1 end
    local pingMs = nil
    pcall(function()
        pingMs = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
    end)

    return {
        Version = "5.0",
        FPS = Perf.fps,
        CachedPlayers = players,
        ESPObjects = (function()
            local n = 0
            for _ in pairs(ESP) do n += 1 end
            return n
        end)(),
        ObjectESPObjects = (function()
            local n = 0
            for _ in pairs(ObjectESP) do n += 1 end
            return n
        end)(),
        Radar = Config.Radar,
        AimAssist = Config.AimAssist,
        FullBright = Config.FullBright,
        NoFog = Config.NoFog,
        LowCPUMode = Config.LowCPUMode,
        Ping = pingMs,
        NoclipCached = #noclipParts,
    }
end
