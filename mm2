local function applyPreset(name)
    if name == "MaxFPS" then
        Config.ESPInterval, Config.RoleInterval, Config.ObjectInterval = 0.35, 1.0, 2.0
        Config.ESPTracers, Config.ObjectESP, Config.Radar = false, false, false
        Config.LowCPUMode, Config.AutoPerf = true, true
    elseif name == "Balanced" then
        Config.ESPInterval, Config.RoleInterval, Config.ObjectInterval = 0.2, 0.75, 1.0
        Config.LowCPUMode, Config.AutoPerf = true, true
    elseif name == "Quality" then
        Config.ESPInterval, Config.RoleInterval, Config.ObjectInterval = 0.12, 0.5, 0.7
        Config.LowCPUMode, Config.AutoPerf = false, false
    end
    notify("Cinder v6.0", "Пресет: " .. name, 2)
end

local function exportConfig()
    local ok, json = pcall(function() return HttpService:JSONEncode(Config) end)
    if not ok then return end
    pcall(function() if setclipboard then setclipboard(json) end end)
    getgenv().CinderV6Export = json
    notify("Cinder v6.0", "Конфиг скопирован (и в getgenv.CinderV6Export)", 3)
end

local function importConfig(json)
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then notify("Cinder v6.0", "Импорт: битый JSON", 3) return end
    for k, v in pairs(data) do Config[k] = v end
    notify("Cinder v6.0", "Конфиг импортирован", 3)
end

getgenv().CinderV6_Export = exportConfig
getgenv().CinderV6_Import = importConfig
getgenv().CinderV6_Preset = applyPreset

