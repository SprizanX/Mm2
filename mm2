-- CHAT COMMANDS (v6.0)
-- ============================================================

local function matchCommand(msg, cmd)
    local lower = string.lower(msg)
    if string.sub(lower, 1, string.len(cmd) + 1) == cmd .. " " then
        return string.sub(lower, string.len(cmd) + 2)
    elseif string.sub(lower, 1, string.len(cmd)) == cmd then
        return true
    end
    return false
end

local function setupChatCommands()
    if TextChatService and TextChatService.TextChannels then
        for _, channel in ipairs(TextChatService.TextChannels:GetChildren()) do
            if channel:IsA("TextChannel") then
                channel.OnMessageDoneFiltering:Connect(function(message)
                    local text = message.Text
                    local cmd, args = matchCommand(text, "/esp")
                    if cmd ~= nil then
                        if args == true then
                            Config.ESP = not Config.ESP
                            if not Config.ESP then clearESP() end
                        else
                            Config.ESP = args == "on" or args == "true"
                            if not Config.ESP then clearESP() end
                        end
                        notify("Cinder v6.0", "ESP: " .. tostring(Config.ESP), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/radar")
                    if cmd ~= nil then
                        Config.Radar = not Config.Radar
                        if not Config.Radar then destroyRadar() end
                        notify("Cinder v6.0", "Radar: " .. tostring(Config.Radar), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/fly")
                    if cmd ~= nil then
                        Config.Fly = not Config.Fly
                        if Config.Fly then startFly() else stopFly() end
                        notify("Cinder v6.0", "Fly: " .. tostring(Config.Fly), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/noclip")
                    if cmd ~= nil then
                        Config.Noclip = not Config.Noclip
                        notify("Cinder v6.0", "Noclip: " .. tostring(Config.Noclip), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/aim")
                    if cmd ~= nil then
                        Config.AimAssist = not Config.AimAssist
                        notify("Cinder v6.0", "Aim: " .. tostring(Config.AimAssist), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/god")
                    if cmd ~= nil then
                        Config.GodMode = not Config.GodMode
                        updateGodMode()
                        notify("Cinder v6.0", "God Mode: " .. tostring(Config.GodMode), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/objects")
                    if cmd ~= nil then
                        Config.ObjectESP = not Config.ObjectESP
                        if not Config.ObjectESP and not Config.CoinESP then clearObjectESP() end
                        notify("Cinder v6.0", "Object ESP: " .. tostring(Config.ObjectESP), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/crosshair")
                    if cmd ~= nil then
                        Config.Crosshair = not Config.Crosshair
                        if not Config.Crosshair then clearDrawingTable(VisualState.Crosshair) end
                        notify("Cinder v6.0", "Crosshair: " .. tostring(Config.Crosshair), 2)
                        return
                    end

                    cmd, args = matchCommand(text, "/status")
                    if cmd ~= nil then
                        local st = getgenv().CinderV6_Status()
                        if st then
                            notify("Cinder v6.0",
                                string.format("FPS:%d | ESP:%s | Aim:%s | Ping:%s | Players:%d | Mode:%s",
                                    st.FPS, tostring(Config.ESP), tostring(Config.AimAssist),
                                    tostring(st.Ping or "--"), st.CachedPlayers, Config.ESPMode),
                                3)
                        end
                        return
                    end

                    cmd, args = matchCommand(text, "/preset")
                    if cmd ~= nil then
                        applyPreset(args or "Balanced")
                        return
                    end

                    cmd, args = matchCommand(text, "/config")
                    if cmd ~= nil then
                        exportConfig()
                        return
                    end
                end)
            end
        end
    end
end

if TextChatService then
    task.defer(setupChatCommands)
