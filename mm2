-- ============================================================

local Perf = {
    fps = 60,
    frameCount = 0,
    last = os.clock(),
    interval = 1,
    autoCut = false,
    autoCutTracers = false,
    autoCutObjects = false,
}

bind("Performance", RunService.RenderStepped, function()
    Perf.frameCount += 1

    local now = os.clock()
    local elapsed = now - Perf.last

    if elapsed >= 1 then
        Perf.fps = math.floor(Perf.frameCount / elapsed)
        Perf.frameCount = 0
        Perf.last = now
        -- v5 AutoPerf: при просадке режем трейсеры/объекты автоматически
        if Config.AutoPerf then
            local low = Perf.fps < (Config.AutoPerfFPS or 28)
            Perf.autoCut = low
            Perf.autoCutTracers = low
            Perf.autoCutObjects = low and Perf.fps < ((Config.AutoPerfFPS or 28) - 5)
        else
            Perf.autoCut = false
            Perf.autoCutTracers = false
            Perf.autoCutObjects = false
        end
    end
end)

local function effectiveInterval(base)
    if not Config.LowCPUMode then
        return base
    end

    if Perf.fps < 30 then
        return base * 2.5
    elseif Perf.fps < 45 then
        return base * 1.5
    end

    return base
end

