        s.SavedNoFog = false
    end
end

local function updateClientVisuals()
    local _sig = (Config.FullBright and "B" or "-") .. (Config.NoFog and "F" or "-") .. tostring(Config.FullBrightIntensity or 2)
    local _nowL = os.clock()
    if _sig == VisualState._lightSig and _nowL - (VisualState._lightAt or 0) < 5 then return end -- v8.0: не дёргаем Lighting каждый кадр
    VisualState._lightSig = _sig
    VisualState._lightAt = _nowL
    if Config.FullBright then
        saveFullBright()
        local intensity = Config.FullBrightIntensity or 2
        Lighting.Brightness = math.clamp(intensity, 1, 5)
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    elseif VisualState.Lighting.SavedFullBright and not Config.NoFog then
        restoreLighting()
    elseif VisualState.Lighting.SavedFullBright then
        local s = VisualState.Lighting
        Lighting.Brightness = s.Brightness
        Lighting.ClockTime = s.ClockTime
        Lighting.GlobalShadows = s.GlobalShadows
        Lighting.Ambient = s.Ambient
        Lighting.OutdoorAmbient = s.OutdoorAmbient
        s.SavedFullBright = false
    end

    if Config.NoFog then
        saveNoFog()
        Lighting.FogEnd = 100000
    elseif VisualState.Lighting.SavedNoFog then
        Lighting.FogEnd = VisualState.Lighting.FogEnd
        VisualState.Lighting.SavedNoFog = false
    end
