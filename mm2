-- UPDATE SCHEDULER
-- ============================================================

local lastESP = 0
local lastObjects = 0
local lastRadar = 0
local lastRoles = 0

bind("Scheduler", RunService.Heartbeat, function()
    local now = os.clock()

    if now - lastRoles >= effectiveInterval(Config.RoleInterval) then
        updateRoles(false)
        lastRoles = now
    end

    if now - lastESP >= effectiveInterval(Config.ESPInterval) then
        updateESP(now)
        lastESP = now
    end

    if Perf.autoCutObjects then
        -- v5: при сильной просадке пропускаем тяжёлый скан объектов
    elseif now - lastObjects >= effectiveInterval(Config.ObjectInterval) then
        scanObjects(now)
        lastObjects = now
    end

    if now - lastRadar >= 0.20 then
        updateRadar()
        lastRadar = now
    end

    setMovementStats()
    noclipStep()
    updateClientVisuals()
    updateCrosshair()
    if now - (Perf._offAt or 0) >= 0.3 then
        Perf._offAt = now
        pcall(updateOffscreen)
    end
end)

