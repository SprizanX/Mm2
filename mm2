bind("LocalCharacter", LocalPlayer.CharacterAdded, function()
    stopFly()
    MobileFly.Up = false
    MobileFly.Down = false
    table.clear(originalCollision)
    table.clear(noclipParts)
    refreshNoclipCache()
    OriginalMovement.WalkSpeed = nil
    OriginalMovement.JumpPower = nil

    task.wait(0.4)

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            refreshPlayer(p)
        end
    end

    if Config.Fly then
        task.wait(0.2)
        startFly()
    end
end)

bind("PlayerAdded", Players.PlayerAdded, bindPlayer)

bind("PlayerRemoving", Players.PlayerRemoving, function(player)
    destroyESP(player)
    clearPlayer(player)
end)

-- Cleanup when this script instance is replaced.
registerCleanup("ESP", clearESP)
registerCleanup("Objects", clearObjectESP)
registerCleanup("Radar", destroyRadar)
registerCleanup("Fly", stopFly)
registerCleanup("Movement", function()
    Config.WalkSpeedEnabled = false
    Config.JumpEnabled = false
    restoreMovementStats()
end)
registerCleanup("PlayerConnections", function()
    for player in pairs(PlayerConnections) do
        clearPlayer(player)
    end
end)

