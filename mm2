local serverHopCache = {}
local serverHopCacheAt = 0

local function serverHop()
    local now = os.clock()
    if serverHopCacheAt > 0 and now - serverHopCacheAt < Config.ServerHopCacheTTL then
        local data = serverHopCache
        if type(data) ~= "table" or type(data.data) ~= "table" then
            goto fresh
        end
        local bestServer = nil
        local bestPlayers = math.huge
        for _, server in ipairs(data.data or {}) do
            if server.id ~= game.JobId
                and server.playing
                and server.maxPlayers
                and server.playing < server.maxPlayers then
                if Config.ServerHopPreferEmpty then
                    if server.playing < bestPlayers then
                        bestPlayers = server.playing
                        bestServer = server
                    end
                else
                    bestServer = server
                    break
                end
            end
        end
        if bestServer then
            pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    bestServer.id,
                    LocalPlayer
                )
            end)
            return
        end
        Rayfield:Notify({
            Title = "Server Hop",
            Content = "Свободный сервер не найден (кеш).",
            Duration = 3,
        })
        return
    end

    ::fresh::
    -- v6.0-final: пагинация по nextPageCursor (до 3 страниц), иначе видны только первые 100
    local allServers = {}
    local cursor = ""
    for page = 1, 3 do
        local baseUrl = string.format(
            "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
            game.PlaceId,
            (cursor ~= "" and ("&cursor=" .. cursor) or "")
        )
        local url = baseUrl
        if type(Config.ServerHopProxy) == "string" and #Config.ServerHopProxy > 8 then
            url = string.format(Config.ServerHopProxy, baseUrl)
        end

        local ok, response = pcall(function()
            return game:HttpGet(url)
        end)

        if not ok then
            if page == 1 then
                Rayfield:Notify({
                    Title = "Server Hop",
                    Content = "Не удалось получить список серверов.",
                    Duration = 3,
                })
                return
            end
            break
        end

        local decoded, data = pcall(function()
            return HttpService:JSONDecode(response)
        end)

        if not decoded or type(data) ~= "table" then
            if page == 1 then
                Rayfield:Notify({ Title = "Server Hop", Content = "Ошибка парсинга ответа.", Duration = 3 })
                return
            end
            break
        end

        for _, s in ipairs(data.data or {}) do table.insert(allServers, s) end
        serverHopCache = { data = allServers, nextPageCursor = data.nextPageCursor }
        serverHopCacheAt = now
        cursor = type(data.nextPageCursor) == "string" and data.nextPageCursor or ""
        if cursor == "" then break end
    end

    local data = { data = allServers }

    local bestServer = nil
    local bestPlayers = math.huge
    for _, server in ipairs(data.data or {}) do
        if server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then
            if Config.ServerHopPreferEmpty then
                if server.playing < bestPlayers then
                    bestPlayers = server.playing
                    bestServer = server
                end
            else
                bestServer = server
                break
            end
        end
    end

    if bestServer then
        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                bestServer.id,
                LocalPlayer
            )
        end)
        return
    end

    Rayfield:Notify({
