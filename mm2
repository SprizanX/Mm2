local refreshPlayer, clearPlayer, bindPlayer
local destroyESP, clearESP, clearObjectESP
local scanCharacter

-- v5 Core: модульная шина событий (Roles/ESP/Aim/Player подписываются сюда)
local Core = { listeners = {} }
function Core.on(event, fn)
    Core.listeners[event] = Core.listeners[event] or {}
    table.insert(Core.listeners[event], fn)
end
function Core.emit(event, ...)
    local ls = Core.listeners[event]
    if not ls then return end
    for _, fn in ipairs(ls) do pcall(fn, ...) end
end

local PlayerCache = {}

scanCharacter = function(player)
    local c = player and player.Character
    if not c then
        return nil
    end

    local hrp = c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
    local old = PlayerCache[player]
    return {
        Character = c,
        Head = c:FindFirstChild("Head"),
        HRP = hrp,
        HumanoidRootPart = hrp,
        Humanoid = c:FindFirstChildOfClass("Humanoid"),
        LastRole = (old and old.LastRole) or "Unknown",
        RoleAt = 0,
        PendingRole = (old and old.PendingRole) or "Unknown",
        PendingCount = (old and old.PendingCount) or 0,
        ToolConns = {},
    }
end

refreshPlayer = function(player)
    if player == LocalPlayer then
        return
    end
    PlayerCache[player] = scanCharacter(player)
end

clearPlayer = function(player)
    PlayerCache[player] = nil

    local conns = PlayerConnections[player]
    if conns then
        for _, connection in ipairs(conns) do
            pcall(function()
                connection:Disconnect()
            end)
        end
        PlayerConnections[player] = nil
    end
end

bindPlayer = function(player)
    if player == LocalPlayer then
        return
    end

    clearPlayer(player)
    refreshPlayer(player)

    local conns = {}
    local cache = PlayerCache[player]

    local function hookTools(char)
        if not char then return end
        for _, c in ipairs(cache and cache.ToolConns or {}) do pcall(function() c:Disconnect() end) end
        if cache then table.clear(cache.ToolConns) end
        local function fastUpdate()
            if not PlayerCache[player] then return end
            local r = detectRole(player)
            if r ~= "Unknown" then
                PlayerCache[player].LastRole = r
                PlayerCache[player].PendingRole = r
                PlayerCache[player].PendingCount = 2
                Core.emit("role", player, r)
            end
        end
        table.insert(conns, char.ChildAdded:Connect(function(ch)
            if ch:IsA("Tool") then task.delay(0.05, fastUpdate) end
        end))
        table.insert(conns, char.ChildRemoved:Connect(function(ch)
            if ch:IsA("Tool") then task.delay(0.05, fastUpdate) end
        end))
    end
    if cache and cache.Character then hookTools(cache.Character) end

    table.insert(conns, player.CharacterAdded:Connect(function(char)
        task.wait(0.15)
        refreshPlayer(player)
        local nc = PlayerCache[player]
        if nc and nc.Character then hookTools(nc.Character) end
    end))

    table.insert(conns, player.CharacterRemoving:Connect(function()
        destroyESP(player)
        clearPlayer(player)
    end))

    PlayerConnections[player] = conns
end

for _, p in ipairs(Players:GetPlayers()) do
    bindPlayer(p)
end

