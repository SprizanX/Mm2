local function normalizeRole(value)
    if type(value) ~= "string" then
        return "Unknown"
    end

    local s = value:lower()

    if s == "murderer" then
        return "Murderer"
    elseif s == "sheriff" then
        return "Sheriff"
    elseif s == "innocent" then
        return "Innocent"
    end

    return "Unknown"
end

detectRole = function(player)
    local cache = PlayerCache[player]
    if not cache then
        return "Unknown"
    end

    local cached = RoleGuiCache[player]
    local value = (cached and cached.Parent and cached:IsA("StringValue")) and cached or nil
    if not value then
        local gui = player:FindFirstChild("PlayerGui")
        if gui then
            local main = gui:FindFirstChild("MainGUI")
            if main then
                local found = main:FindFirstChild("Role", true)
                if found and found:IsA("StringValue") then
                    RoleGuiCache[player] = found
                    value = found
                end
            end
        end
    end
    if value then
        local role = normalizeRole(value.Value)
        if role ~= "Unknown" then
            return role
        end
    end
    local okAttr, attrRole = pcall(function()
        return player:GetAttribute("Role") or (cache.Character and cache.Character:GetAttribute("Role"))
    end)
    if okAttr and type(attrRole) == "string" then
        local role = normalizeRole(attrRole)
        if role ~= "Unknown" then return role end
    end
    local function toolRole(container)
        if not container then return nil end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                local n = item.Name:lower()
                if n:find("knife", 1, true) then return "Murderer" end
                if n:find("gun", 1, true) or n:find("revolver", 1, true) then return "Sheriff" end
            end
        end
        return nil
    end
    local c = cache.Character
    local r1 = toolRole(c)
    if r1 then return r1 end
    local bp = player:FindFirstChildOfClass("Backpack")
    local r2 = toolRole(bp)
    if r2 then return r2 end
    return "Unknown"
end

updateRoles = function(force)
    local now = os.clock()
    for player, cache in pairs(PlayerCache) do
        if cache then
            if force or now - cache.RoleAt >= effectiveInterval(Config.RoleInterval) then
                local detected = detectRole(player)
                if detected == "Unknown" then
                    if cache.LastRole == "Unknown" or force then
                        cache.LastRole = "Unknown"
                    end
                elseif detected == cache.LastRole then
                    cache.PendingRole = detected
                    cache.PendingCount = 2
                elseif detected == cache.PendingRole then
                    cache.PendingCount = (cache.PendingCount or 0) + 1
                    if cache.PendingCount >= 2 or force then
                        if cache.LastRole ~= detected then
                            cache.LastRole = detected
                            Core.emit("role", player, detected)
                        end
                    end
                else
                    cache.PendingRole = detected
                    cache.PendingCount = 1
                    if force then
                        cache.LastRole = detected
                        Core.emit("role", player, detected)
                    end
                end
                cache.RoleAt = now
            end
        end
    end
end

local function getRole(player)
    local cache = PlayerCache[player]
    return cache and cache.LastRole or "Unknown"
end

local function roleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(255, 70, 70)
    elseif role == "Sheriff" then
        return Color3.fromRGB(80, 130, 255)
    elseif role == "Innocent" then
        return Color3.fromRGB(80, 235, 110)
    end
    return Color3.fromRGB(220, 220, 220)
end

local function radarDotColor(role)
    if role == "Murderer" then return Config.RadarDotColorMurderer
    elseif role == "Sheriff" then return Config.RadarDotColorSheriff
    elseif role == "Innocent" then return Config.RadarDotColorInnocent
    end
    return Config.RadarDotColorUnknown
end

local function roleEnabled(role)
    if role == "Murderer" then return Config.ShowMurderer end
    if role == "Sheriff" then return Config.ShowSheriff end
    if role == "Innocent" then return Config.ShowInnocent end
