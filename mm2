local function updateCrosshair()
    if not DrawingAvailable then return end

    if not Config.Crosshair then
        clearDrawingTable(VisualState.Crosshair)
        return
    end

    if #VisualState.Crosshair == 0 then
        for _ = 1, 4 do
            local ok, line = pcall(function()
                return Drawing.new("Line")
            end)
            if ok and line then
                line.Thickness = 2
                line.Transparency = 0.9
                line.Color = Color3.fromRGB(255, 255, 255)
                table.insert(VisualState.Crosshair, line)
            end
        end
    end

    local cam = camera()
    if not cam then return end

    local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    local size = math.max(2, Config.CrosshairSize)
    local gap = 3

    local positions = {
        {Vector2.new(center.X - gap - size, center.Y), Vector2.new(center.X - gap, center.Y)},
        {Vector2.new(center.X + gap, center.Y), Vector2.new(center.X + gap + size, center.Y)},
        {Vector2.new(center.X, center.Y - gap - size), Vector2.new(center.X, center.Y - gap)},
        {Vector2.new(center.X, center.Y + gap), Vector2.new(center.X, center.Y + gap + size)},
    }

    for i, line in ipairs(VisualState.Crosshair) do
        line.From = positions[i][1]
        line.To = positions[i][2]
        line.Visible = true
    end
end

