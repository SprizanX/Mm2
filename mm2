local function serverHop()
    local baseUrl = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local url = baseUrl
    if type(Config.ServerHopProxy) == "string" and #Config.ServerHopProxy > 8 then
        url = string.format(Config.ServerHopProxy, baseUrl)
    end

    local ok, response = pcall(function()
        return game:HttpGet(url)
    end)

    if not ok then
        Rayfield:Notify({
            Title = "Server Hop",
            Content = "Не удалось получить список серверов.",
            Duration = 3,
        })
        return
    end

    local decoded, data = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not decoded or type(data) ~= "table" then
        Rayfield:Notify({ Title = "Server Hop", Content = "Ошибка парсинга ответа.", Duration = 3 })
        return
    end

    for _, server in ipairs(data.data or {}) do
        if server.id ~= game.JobId
            and server.playing
            and server.maxPlayers
            and server.playing < server.maxPlayers then

            pcall(function()
                TeleportService:TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    LocalPlayer
                )
            end)

            return
        end
    end

    Rayfield:Notify({
        Title = "Server Hop",
        Content = "Свободный сервер не найден.",
        Duration = 3,
    })
end

