getgenv().CinderProfiles = getgenv().CinderProfiles or {}
local function saveProfile(slot)
    local ok, json = pcall(function() return HttpService:JSONEncode(Config) end)
    if not ok then notify("Cinder v7.0", "Profile serialize error", 2) return end
    getgenv().CinderProfiles[slot] = json
    pcall(function() if setclipboard then setclipboard(json) end end)
    notify("Cinder v7.0", string.format("Profile %d saved + clipboard", slot), 2)
end
local function loadProfile(slot)
    local json = getgenv().CinderProfiles and getgenv().CinderProfiles[slot]
    if not json then notify("Cinder v7.0", string.format("Profile %d empty", slot), 2) return end
    local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(data) ~= "table" then notify("Cinder v7.0", "Profile corrupted", 2) return end
    for k, v in pairs(data) do Config[k] = v end
    notify("Cinder v7.0", string.format("Profile %d loaded", slot), 2)
end
getgenv().CinderV7_SaveProfile = saveProfile
getgenv().CinderV7_LoadProfile = loadProfile

