local function refreshNoclipCache()
    table.clear(noclipParts)
    local c = character()
    if not c then return end
    for _, obj in ipairs(c:GetChildren()) do
        if obj:IsA("BasePart") then
            table.insert(noclipParts, obj)
        end
    end
    noclipPartsDirty = false
end

local function noclipStep()
    if noclipPartsDirty or #noclipParts == 0 then
        refreshNoclipCache()
    end
    for _, obj in ipairs(noclipParts) do
        if obj and obj.Parent then
            if Config.Noclip then
                if originalCollision[obj] == nil then
                    originalCollision[obj] = obj.CanCollide
                end
                obj.CanCollide = false
            elseif originalCollision[obj] ~= nil then
                obj.CanCollide = originalCollision[obj]
                originalCollision[obj] = nil
            end
        end
    end
end

local function stopFly()
    unbind("Fly")
    if flyVelocity then
        safeDestroy(flyVelocity)
        flyVelocity = nil
    end
    if flyAttachment then
        safeDestroy(flyAttachment)
        flyAttachment = nil
    end
end

local function startFly()
    stopFly()

    local c = character()
    local r = c and c:FindFirstChild("HumanoidRootPart")
    if not r then return end

    flyAttachment = Instance.new("Attachment")
    flyAttachment.Name = "CinderFlyAttachment"
    flyAttachment.Parent = r

    flyVelocity = Instance.new("LinearVelocity")
    flyVelocity.Name = "CinderFlyVelocity"
    flyVelocity.Attachment0 = flyAttachment
    flyVelocity.MaxForce = math.huge
    flyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    flyVelocity.VectorVelocity = Vector3.zero
    flyVelocity.Parent = r

    bind("Fly", RunService.RenderStepped, function()
        if not Config.Fly or LocalPlayer.Character ~= c then
            stopFly()
            return
        end

        local cam = camera()
        if not cam or not flyVelocity then return end

        local direction = Vector3.zero

        -- v6.0: FlyLookDirection
        local moveDir = Config.FlyLookDirection and cam.CFrame.LookVector or Vector3.new(0, 0, -1)

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += moveDir
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= moveDir
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) or MobileFly.Up then
            direction += Vector3.yAxis
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or MobileFly.Down then
            direction -= Vector3.yAxis
        end

        flyVelocity.VectorVelocity =
            direction.Magnitude > 0
            and direction.Unit * Config.FlySpeed
            or Vector3.zero
    end)
end

