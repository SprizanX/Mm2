end

local pingGuiUpdateAt = 0
local function updatePingWidget()
    if not pingLabel then return end
    local now = os.clock()
    if now - pingGuiUpdateAt < 2 then return end
    pingGuiUpdateAt = now
    local pingMs = nil
    pcall(function()
        pingMs = Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
    end)
    pingLabel.Text = "Ping: " .. tostring(pingMs or "--") .. "ms"
end

